# Puerto del servidor (Render inyecta PORT automáticamente)
PORT=4100

# MongoDB — base de datos SEPARADA del resto de productos
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=ommex_academia

# Secreto para firmar los JWT de sesión
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Microservicio de reconocimiento facial (DeepFace). Si se omite, la verificación
# facial se omite silenciosamente (bypass) y la asistencia se marca igual.
FACE_SERVICE_URL=
